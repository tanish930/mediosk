generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  name           String?
  email          String    @unique
  role           Role
  hashedPassword String
  createdAt      DateTime  @default(now())
  doctor         Doctor?
  hospital       Hospital?
  patient        Patient?
}

model Patient {
  id                      String                   @id @default(uuid())
  userId                  String                   @unique
  abhaId                  String?                  @unique
  abhaLinkedAt            DateTime?
  dob                     DateTime?
  gender                  String?
  preferredLanguage       String?
  ayushAssessments        AyushAssessment[]
  consents                Consent[]
  consultations           Consultation[]
  emergencyAlerts         EmergencyAlert[]
  documents               MedicalDocument[]
  summaries               MedicalSummary[]
  timelines               MedicalTimeline[]
  user                    User                     @relation(fields: [userId], references: [id])
  complaints              PatientComplaint[]
  preConsultationSessions PreConsultationSession[]
}

model Doctor {
  id               String               @id @default(uuid())
  userId           String               @unique
  speciality       String?
  ayushAssessments AyushAssessment[]
  consultations    Consultation[]
  user             User                 @relation(fields: [userId], references: [id])
  credentials      DoctorCredential[]
  verifications    DoctorVerification[]
  hospitalLinks    HospitalDoctor[]
}

model Hospital {
  id              String           @id @default(uuid())
  userId          String           @unique
  address         String?
  emergencyAlerts EmergencyAlert[]
  user            User             @relation(fields: [userId], references: [id])
  hospitalDoctors HospitalDoctor[]
}

model DoctorCredential {
  id       String @id @default(uuid())
  doctorId String
  type     String
  detail   String
  doctor   Doctor @relation(fields: [doctorId], references: [id])
}

model Consent {
  id              String    @id @default(uuid())
  patientId       String
  granted         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  granteeDoctorId String?
  grantedAt       DateTime?
  revokedAt       DateTime?
  patient         Patient   @relation(fields: [patientId], references: [id])
}

model Consultation {
  id              String                  @id @default(uuid())
  doctorId        String?
  patientId       String
  sessionId       String?                 @unique
  scheduledAt     DateTime?
  status          ConsultationStatus      @default(PENDING)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  ayushAssessment AyushAssessment?
  doctor          Doctor?                 @relation(fields: [doctorId], references: [id])
  patient         Patient                 @relation(fields: [patientId], references: [id])
  session         PreConsultationSession? @relation(fields: [sessionId], references: [id])
  emergencyAlerts EmergencyAlert[]
}

model DoctorVerification {
  id         String             @id @default(uuid())
  doctorId   String
  targetType String
  targetId   String
  status     VerificationStatus @default(AI_GENERATED)
  note       String?
  createdAt  DateTime           @default(now())
  doctor     Doctor             @relation(fields: [doctorId], references: [id])
}

model MedicalDocument {
  id           String                 @id @default(uuid())
  patientId    String
  title        String
  url          String
  category     String?
  documentDate DateTime?
  uploadedAt   DateTime               @default(now())
  processing   DocumentProcessing[]
  extractions  ExtractedMedicalData[]
  patient      Patient                @relation(fields: [patientId], references: [id])
  timelines    MedicalTimeline[]
}

model PatientComplaint {
  id          String          @id @default(uuid())
  patientId   String
  title       String
  description String?
  createdAt   DateTime        @default(now())
  patient     Patient         @relation(fields: [patientId], references: [id])
  reports     SymptomReport[]
}

model AccessAudit {
  id             String   @id @default(uuid())
  actorId        String
  actorRole      String
  patientId      String
  doctorId       String?
  consultationId String?
  action         String
  note           String?
  createdAt      DateTime @default(now())
}

model SymptomReport {
  id          String            @id @default(uuid())
  complaintId String
  createdAt   DateTime          @default(now())
  complaint   PatientComplaint  @relation(fields: [complaintId], references: [id])
  responses   SymptomResponse[]
}

model SymptomResponse {
  id       String        @id @default(uuid())
  reportId String
  question String
  answer   String
  report   SymptomReport @relation(fields: [reportId], references: [id])
}

model MedicalTimeline {
  id               String           @id @default(uuid())
  patientId        String
  title            String
  details          String?
  entryType        EntryType
  date             DateTime         @default(now())
  sourceDocumentId String?
  createdAt        DateTime         @default(now())
  patient          Patient          @relation(fields: [patientId], references: [id])
  sourceDocument   MedicalDocument? @relation(fields: [sourceDocumentId], references: [id])
}

model DocumentProcessing {
  id         String          @id @default(uuid())
  documentId String
  status     String          @default("PENDING")
  error      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  document   MedicalDocument @relation(fields: [documentId], references: [id])
}

model ExtractedMedicalData {
  id         String          @id @default(uuid())
  documentId String
  extracted  Json
  createdAt  DateTime        @default(now())
  document   MedicalDocument @relation(fields: [documentId], references: [id])
}

model MedicalSummary {
  id             String   @id @default(uuid())
  patientId      String
  authorId       String?
  provider       String?
  version        Int      @default(1)
  status         String   @default("PENDING")
  patientSummary String?
  doctorSummary  Json?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  patient        Patient  @relation(fields: [patientId], references: [id])
}

model QuestionTemplate {
  id               String            @id @default(uuid())
  domain           String
  key              String            @unique
  text             String
  type             QuestionType
  options          QuestionOption[]
  sessionQuestions SessionQuestion[]
}

model QuestionOption {
  id         String           @id @default(uuid())
  questionId String
  value      String
  label      String
  question   QuestionTemplate @relation(fields: [questionId], references: [id])
}

model PreConsultationSession {
  id           String                 @id @default(uuid())
  patientId    String
  complaint    String
  domain       String?
  status       String                 @default("IN_PROGRESS")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  consultation Consultation?
  report       PreConsultationReport?
  patient      Patient                @relation(fields: [patientId], references: [id])
  questions    SessionQuestion[]
}

model SessionQuestion {
  id         String                 @id @default(uuid())
  sessionId  String
  templateId String?
  text       String
  type       QuestionType
  options    Json?
  order      Int
  answered   Boolean                @default(false)
  answer     SessionAnswer?
  session    PreConsultationSession @relation(fields: [sessionId], references: [id])
  template   QuestionTemplate?      @relation(fields: [templateId], references: [id])
}

model SessionAnswer {
  id         String          @id @default(uuid())
  questionId String          @unique
  value      Json
  createdAt  DateTime        @default(now())
  question   SessionQuestion @relation(fields: [questionId], references: [id])
}

model PreConsultationReport {
  id                 String                 @id @default(uuid())
  sessionId          String                 @unique
  chiefComplaint     String
  onsetDuration      String?
  location           String?
  severity           String?
  character          String?
  frequencyPattern   String?
  associated         Json?
  aggravating        Json?
  relieving          Json?
  relevantHistory    Json?
  currentMedications Json?
  allergies          Json?
  otherInfo          Json?
  redFlags           Json?
  createdAt          DateTime               @default(now())
  session            PreConsultationSession @relation(fields: [sessionId], references: [id])
}

model AyushAssessment {
  id             String             @id @default(uuid())
  patientId      String
  consultationId String?            @unique
  doctorId       String
  prakriti       String?
  vikriti        String?
  sara           String?
  samhanna       String?
  pramana        String?
  satmya         String?
  sattva         String?
  aharaShakti    String?
  vyayamaShakti  String?
  vaya           String?
  aharaVihara    String?
  agni           String?
  nadi           String?
  note           String?
  status         VerificationStatus @default(REVIEWED)
  verifiedBy     String?
  verifiedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  consultation   Consultation?      @relation(fields: [consultationId], references: [id])
  doctor         Doctor             @relation(fields: [doctorId], references: [id])
  patient        Patient            @relation(fields: [patientId], references: [id])
}

model EmergencyAlert {
  id             String            @id @default(uuid())
  patientId      String
  consultationId String?
  hospitalId     String?
  severity       EmergencySeverity @default(NORMAL)
  status         EmergencyStatus   @default(OPEN)
  reason         String?
  source         EmergencySource   @default(RED_FLAG)
  createdBy      String?
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  consultation   Consultation?     @relation(fields: [consultationId], references: [id])
  hospital       Hospital?         @relation(fields: [hospitalId], references: [id])
  patient        Patient           @relation(fields: [patientId], references: [id])
}

model HospitalDoctor {
  id         String               @id @default(uuid())
  hospitalId String
  doctorId   String
  status     HospitalDoctorStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  doctor     Doctor               @relation(fields: [doctorId], references: [id])
  hospital   Hospital             @relation(fields: [hospitalId], references: [id])
}

enum Role {
  PATIENT
  DOCTOR
  HOSPITAL
}

enum ConsultationStatus {
  PENDING
  REQUESTED
  READY
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  AI_GENERATED
  REVIEWED
  VERIFIED
}

enum EntryType {
  DIAGNOSIS
  MEDICINE
  INVESTIGATION
  PROCEDURE
  FINDING
}

enum QuestionType {
  TEXT
  NUMBER
  YESNO
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum EmergencySeverity {
  NORMAL
  URGENT
  EMERGENCY
}

enum EmergencyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

enum EmergencySource {
  PRECONSULTATION
  RED_FLAG
  AI_CONTEXT
}

enum HospitalDoctorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
